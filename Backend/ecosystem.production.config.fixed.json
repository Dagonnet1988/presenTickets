{
  "apps": [
    {
      "name": "presentickets-backend",
      "script": "server.js",
      "cwd": "/var/www/presentickets/Backend",
      "env": {
        "NODE_ENV": "development"
      },
      "env_production": {
        "NODE_ENV": "production"
      },
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "1G",
      "error_file": "/var/log/presentickets/backend-error.log",
      "out_file": "/var/log/presentickets/backend-out.log",
      "log_file": "/var/log/presentickets/backend-combined.log",
      "time": true,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "restart_delay": 4000
    }
  ]
}
